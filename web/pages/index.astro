            read the same registry.
          </p>
          <a href="/docs/routing/" class="alink text-[14px] mt-5 inline-block">Routing docs</a>
        </div>
        <div class="codebox" data-panel="routing">
          <div class="codebar"><span>src/shell/route.rs</span><span>rust</span></div>
          <div class="codebody"><pre><span class="c-dim">// register once: sidebar, Cmd+K and deep links follow</span>
<span class="c-key">pub fn</span> routes(cx: &amp;<span class="c-key">mut</span> App) -&gt; Vec&lt;Route&gt; {
    <span class="c-key">vec!</span>[
        Route::new(Page::Home).icon(<span class="c-str">"house"</span>),
        Route::new(Page::Form).icon(<span class="c-str">"file-text"</span>),
        Route::new(Page::Settings).icon(<span class="c-str">"settings"</span>),
        Route::new(Page::Diagnostics).dev_only(),
    ]
}</pre></div>
        </div>

        <div class="hidden" data-panel="themes">
          <h3 class="t-h3 display">Theme system</h3>
          <p class="lead text-[15px] mt-3">
            24 themes ship as plain JSON in <code class="inline">themes/</code>. The watcher picks
            up a new file while the app runs.
          </p>
          <a href="/docs/themes/" class="alink text-[14px] mt-5 inline-block">Theme guide</a>
        </div>
        <div class="codebox hidden" data-panel="themes">
          <div class="codebar"><span>themes/tokyonight.json</span><span>json</span></div>
          <div class="codebody"><pre>{'{'}
  <span class="c-key">"name"</span>: <span class="c-str">"Tokyo Night"</span>,
  <span class="c-key">"appearance"</span>: <span class="c-str">"dark"</span>,
  <span class="c-key">"colors"</span>: {'{'}
    <span class="c-key">"background"</span>: <span class="c-str">"#1a1b26"</span>,
    <span class="c-key">"foreground"</span>: <span class="c-str">"#c0caf5"</span>,
    <span class="c-key">"accent"</span>:     <span class="c-str">"#7aa2f7"</span>
  {'}'}
{'}'}
<span class="c-dim">// drop in themes/ → live in the switcher</span></pre></div>
        </div>

        <div class="hidden" data-panel="i18n">
          <h3 class="t-h3 display">Fluent i18n</h3>
          <p class="lead text-[15px] mt-3">
            Built on <code class="inline">es-fluent</code>, so message keys are typed at compile
            time. Validation errors resolve through the same bundle.
          </p>
          <a href="/docs/i18n/" class="alink text-[14px] mt-5 inline-block">i18n setup</a>
        </div>
        <div class="codebox hidden" data-panel="i18n">
          <div class="codebar"><span>i18n/en/app.ftl</span><span>fluent</span></div>
          <div class="codebody"><pre>form-email-invalid = <span class="c-str">{'{'} $value {'}'} is not a valid email</span>
update-available   = <span class="c-str">Version {'{'} $version {'}'} is ready</span>

<span class="c-dim">// src/pages/form.rs</span>
label.child(t!(FormEmailInvalid {'{'} value: &amp;input {'}'}))</pre></div>
        </div>

        <div class="hidden" data-panel="forms">
          <h3 class="t-h3 display">Forms &amp; validation</h3>
          <p class="lead text-[15px] mt-3">
            <code class="inline">gpui-form</code> binds inputs to a struct;
            <code class="inline">koruma</code> derives the rules. Messages come back localized, per field.
          </p>
          <a href="/docs/forms/" class="alink text-[14px] mt-5 inline-block">Forms guide</a>
        </div>
        <div class="codebox hidden" data-panel="forms">
          <div class="codebar"><span>src/pages/form.rs</span><span>rust</span></div>
          <div class="codebody"><pre><span class="c-dim">#[derive(Form, Validate)]</span>
<span class="c-key">struct</span> SignUp {'{'}
    <span class="c-dim">#[validate(email)]</span>
    email: String,
    <span class="c-dim">#[validate(length(min = 8))]</span>
    password: String,
    <span class="c-dim">#[validate(url, optional)]</span>
    website: Option&lt;String&gt;,
{'}'}</pre></div>
        </div>

        <div class="hidden" data-panel="query">
          <h3 class="t-h3 display">gpui-query</h3>
          <p class="lead text-[15px] mt-3">
            Cache policy per query, plus retries, invalidation and cancellation, all observable
            from an entity.
          </p>
          <a href="/docs/gpui-query/" class="alink text-[14px] mt-5 inline-block">gpui-query docs</a>
        </div>
        <div class="codebox hidden" data-panel="query">
          <div class="codebar"><span>src/pages/home.rs</span><span>rust</span></div>
          <div class="codebody"><pre><span class="c-key">let</span> projects = use_query(
    QueryKey::new(<span class="c-str">"projects"</span>),
    |_| <span class="c-key">async</span> {'{'} api::projects().await {'}'},
    QueryOptions {'{'}
        cache: CachePolicy::StaleWhileRevalidate(60.secs()),
        retry: RetryPolicy::exponential(3),
        ..default()
    {'}'},
    cx,
);</pre></div>
        </div>

        <div class="hidden" data-panel="notify">
          <h3 class="t-h3 display">Notifications</h3>
