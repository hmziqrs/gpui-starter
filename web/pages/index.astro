---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import AppPreview from '../components/AppPreview.astro';
import { latestVersion } from '../util/changelog';
import { formatDate } from '../util/author';

const CLONE = 'git clone https://github.com/freeoxide/gpui-starter.git';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .toSorted((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const [featured, ...rest] = posts;

const themes = [
  'Adventure', 'Alduin', 'Asciinema', 'Ayu', 'Catppuccin', 'Crush',
  'Everforest', 'Fahrenheit', 'Flexoki', 'Gruvbox', 'Harper',
  'High Contrast Dark', 'High Contrast Light', 'Hybrid', 'Jellybeans',
  'Kibble', 'macOS Classic', 'Matrix', 'Mellifluous', 'Molokai',
  'Solarized', 'Spaceduck', 'Tokyo Night', 'Twilight',
];

const subsystems = [
  {
    title: 'App shell',
    sub: 'replaces hand-rolled chrome',
    body: 'Custom title bar with drag regions and traffic lights, collapsible sidebar, status bar, route-based pages.',
    code: 'impl Render for Page',
    href: '/docs/architecture/',
    icon: 'M4 17l6-5-6-5 M12 19h8',
  },
  {
    title: 'Persistence',
    sub: 'replaces sqlite glue · dirs · keyring',
    body: 'rusqlite storage, versioned JSON config with a migration chain, OS keyring for secrets.',
    code: 'db.migrate_to(V3)',
    href: '/docs/secure-storage/',
    icon: 'M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6',
  },
  {
    title: 'OS integration',
    sub: 'replaces tauri plugins',
    body: 'Tray menu, native notifications with toast fallback, global hotkey, deep links through the instance guard.',
    code: 'gpui-starter://open',
    href: '/docs/notifications/',
    icon: 'M3 4h18v13H3z M8 21h8',
  },
  {
    title: 'gpui-query',
    sub: 'replaces bespoke async state',
    body: 'TanStack-style caching for entities: stale-while-revalidate, retries, invalidation, infinite queries.',
    code: 'use_query("projects")',
    href: '/docs/gpui-query/',
    icon: 'M4 4v6h6 M20 20v-6h-6 M20 9A8 8 0 0 0 6 6M4 15a8 8 0 0 0 14 3',
  },
];

const pages = [
  { n: '01', title: 'Home', body: 'Landing page for the shell, wired to gpui-query so you can see cached async data on first paint.' },
  { n: '02', title: 'Form', body: 'gpui-form inputs bound to a struct, koruma validation rules, errors localized through Fluent.' },
  { n: '03', title: 'Settings', body: 'Theme switcher, locale picker and telemetry consent gate, all persisted to versioned JSON config.' },
  { n: '04', title: 'About', body: 'Version, build metadata and update check, backed by the ed25519-signed updater.' },
  { n: '05', title: 'Diagnostics', body: 'Live subsystem health, active entities, theme metadata, and debug actions for support.' },
  { n: '06', title: 'Notifications', body: 'Native OS notifications with in-app toast fallback and a persistent inbox the user can reopen.' },
];

const steps = [
  {
    title: 'Install',
    cmd: '$ cargo run',
    desc: 'Builds and launches the shell with all six pages wired. You install no extra toolchain and run no bundler.',
    bar: 'terminal · install',
  },
  {
    title: 'Theme it',
    cmd: '$ cp themes/gruvbox.json themes/mine.json',
    desc: 'The watcher reloads themes and Fluent bundles in place, so the app keeps running.',
    bar: 'terminal · theme it',
  },
  {
    title: 'Test',
    cmd: '$ cargo test',
    desc: 'Integration harness under cfg(test), including updater signature rejection.',
    bar: 'terminal · test',
  },
  {
    title: 'Bundle',
    cmd: '$ bash scripts/macos-dev-app.sh',
    desc: 'Produces a codesigned .app you can open straight from the terminal.',
    bar: 'terminal · bundle',
  },
  {
    title: 'Ship',
    cmd: '$ just release 0.3.0',
    desc: 'Signs the manifest with ed25519 and pushes a GitHub release clients can verify.',
    bar: 'terminal · ship',
  },
];

const wiring = [
  { title: 'Command launcher', path: 'features/command_palette.rs', body: 'Cmd+K opens a floating palette with fuzzy search across every registered action. Full keyboard navigation.' },
  { title: 'Undo / redo', path: 'services/undo_stack.rs', body: 'Command-pattern stack behind Cmd+Z / Cmd+Y. One trait to implement per action, works across any operation.' },
  { title: 'Crash reporting', path: 'services/crash_report.rs', body: 'Panic hooks capture stack traces and write structured reports to disk. Surface or upload them on next launch.' },
  { title: 'Telemetry', path: 'services/telemetry/', body: 'Three modes (disabled, local-only, remote) behind an explicit consent gate. You decide what leaves the machine.' },
  { title: 'Logging', path: 'services/logging.rs', body: 'File-based logging through tracing-appender, with env-filter levels wired to the same config.' },
  { title: 'Accessibility', path: 'services/accessibility.rs', body: 'AccessKit integration so the tree is exposed to VoiceOver, Narrator and Orca.' },
  { title: 'Secure storage', path: 'services/secure_storage.rs', body: 'OS keyring for secrets: macOS Keychain, Windows Credential Manager, Linux Secret Service.' },
  { title: 'Deep links', path: 'platform/ipc/', body: 'URL-scheme handling forwarded through the single-instance guard, so a link reaches the running window.' },
  { title: 'Lifecycle', path: 'services/first_run.rs', body: 'Startup, shutdown and crash state machine, including first-run detection for onboarding.' },
  { title: 'Connectivity', path: 'services/connectivity.rs', body: 'Online/offline awareness so async work can back off instead of piling up retries.' },
  { title: 'Background tasks', path: 'services/tasks.rs', body: 'A task registry over the tokio runtime, cancelled cleanly on shutdown.' },
  { title: 'Error surface', path: 'services/error_surface.rs', body: 'One place errors are collected and rendered, instead of unwrap() scattered through the UI.' },
];

const comparison = [
  ['Native GPU rendering', '✓', '✓', 'webview', 'webview'],
  ['Sidebar + page routing', '✓', '—', '—', '—'],
  ['Theme system, hot-reload', '24 built in', '—', 'CSS', 'CSS'],
  ['i18n with typed keys', '✓ Fluent', '—', 'plugin', 'library'],
  ['Command launcher (Cmd+K)', '✓', '—', '—', '—'],
  ['Signed auto-updater', '✓ ed25519', '—', '✓', '✓'],
  ['Keyring / secure storage', '✓', '—', 'plugin', 'plugin'],
  ['Crash reports + diagnostics', '✓', '—', '—', '✓'],
  ['Screen reader support', '✓ AccessKit', 'manual', '✓', '✓'],
  ['Ships a browser engine', 'no', 'no', 'system', 'bundled'],
];
---

<MarketingLayout
  title="gpui-starter: Rust desktop app boilerplate for GPUI"
  description="Ship a Rust desktop app with GPUI in minutes, not weeks. 24 themes, i18n, form validation, Cmd+K launcher, SQLite persistence, signed auto-updater, and macOS tray out of the box."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'gpui-starter',
    url: 'https://gpui-starter.freeoxide.com',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://gpui-starter.freeoxide.com/docs/?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  }}
>
  <!-- ===== HERO ===== -->
  <section class="border-b border-line">
    <div class="frame py-14 md:py-20">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.02fr)] gap-12 lg:gap-14">
        <div>
          <div class="flex items-center gap-3">
            <span class="tag">New</span>
            <a href="/changelog/" class="mono text-[11.5px] tracking-[.12em] uppercase text-fg-muted hover:text-fg no-underline transition-colors"
              >v{latestVersion} released &rarr;</a
            >
          </div>

          <h1 class="display t-hero mt-6">
            One repo for the <span class="text-accent">whole</span> desktop app.
          </h1>

          <p class="lead mt-7 max-w-[46ch]">
            Routing, 24 themes, Fluent i18n, SQLite, keyring, tray, signed updates and a
            Cmd+K launcher are already wired. Run <code class="inline">cargo run</code>, then
            start deleting what you don't need.
          </p>

          <p class="text-[14px] font-semibold mt-10">Clone gpui-starter v{latestVersion}</p>
          <div class="mt-3 flex items-stretch codebox">
            <div class="flex-1 min-w-0 flex items-center gap-2.5 px-4 py-3.5 overflow-x-auto">
              <span class="c-p mono text-[14px]">$</span>
              <code class="mono text-[13.5px] whitespace-nowrap">{CLONE}</code>
            </div>
            <button
              class="copy-btn shrink-0 w-11 grid place-items-center text-fg-subtle hover:text-fg bg-transparent cursor-pointer transition-colors border-0 border-l border-l-line"
              data-copy={CLONE}
              aria-label="Copy clone command"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
                ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg
              >
            </button>
          </div>

          <div class="mt-4 flex items-center justify-between gap-4 flex-wrap">
            <div class="flex gap-2 flex-wrap">
              <span class="pill">macOS</span>
              <span class="pill">Linux</span>
              <span class="pill">Windows</span>
            </div>
            <a href="/docs/getting-started/" class="text-[13px] text-fg-muted hover:text-fg no-underline transition-colors"
              >Build requirements &nearr;</a
            >
          </div>

          <p class="mt-8">
            <a href="#workflow" class="alink font-semibold text-[15px]">Then follow the quickstart</a>
            <span class="text-fg-muted">&rarr;</span>
          </p>
        </div>

        <!-- terminal panel -->
        <div class="self-start w-full border border-rule">
          <div class="grid grid-cols-3" role="tablist" data-heroterm-tabs aria-label="Terminal output">
            <button
              class="heroterm-tab h-11 text-[13px] font-medium bg-transparent cursor-pointer transition-colors border-0 border-r border-r-rule border-b border-b-rule"
              role="tab"
              aria-selected="true"
              data-term="run">cargo run</button
            >
            <button
              class="heroterm-tab h-11 text-[13px] font-medium bg-transparent cursor-pointer transition-colors border-0 border-r border-r-rule border-b border-b-rule"
              role="tab"
              aria-selected="false"
              data-term="test">cargo test</button
            >
            <button
              class="heroterm-tab h-11 text-[13px] font-medium bg-transparent cursor-pointer transition-colors border-0 border-b border-b-rule"
              role="tab"
              aria-selected="false"
              data-term="theme">hot reload</button
            >
          </div>

          <div class="p-6">
            <div class="codebody min-h-[280px] p-0">
              <pre data-term-panel="run"><span class="c-p">$ </span>cargo run
<span class="c-dim">   Compiling gpui-starter v{latestVersion}</span>
<span class="c-dim">    Finished `dev` profile</span>
<span class="c-dim">     Running `target/debug/gpui-starter`</span>

<span class="c-ok">  ✓</span> lifecycle       <span class="c-dim">first_run = true</span>
<span class="c-ok">  ✓</span> single-instance <span class="c-dim">lock acquired</span>
<span class="c-ok">  ✓</span> themes          <span class="c-dim">24 loaded, watching ./themes</span>
<span class="c-ok">  ✓</span> i18n            <span class="c-dim">en, zh-CN</span>
<span class="c-ok">  ✓</span> sqlite          <span class="c-dim">app support dir</span>
<span class="c-ok">  ✓</span> tray            <span class="c-dim">menu bar registered</span>

<span class="c-str">  window ready</span></pre>
              <pre class="hidden" data-term-panel="test"><span class="c-p">$ </span>cargo test
<span class="c-dim">test lifecycle::first_run ............... </span><span class="c-ok">ok</span>
<span class="c-dim">test config::migrate_v1_to_v3 ........... </span><span class="c-ok">ok</span>
<span class="c-dim">test updater::rejects_bad_signature ..... </span><span class="c-ok">ok</span>
<span class="c-dim">test i18n::all_keys_resolve_zh_cn ....... </span><span class="c-ok">ok</span>
<span class="c-dim">test query::stale_while_revalidate ...... </span><span class="c-ok">ok</span>

<span class="c-ok">test result: ok.</span> <span class="c-dim">0 failed</span></pre>
              <pre class="hidden" data-term-panel="theme"><span class="c-p">$ </span>cp themes/gruvbox.json themes/mine.json
<span class="c-dim">  watcher  themes/mine.json added</span>
<span class="c-ok">  ✓</span> theme reloaded  <span class="c-dim">no restart · 25 themes</span>

<span class="c-p">$ </span>vim i18n/zh-CN/app.ftl
<span class="c-dim">  watcher  i18n/zh-CN/app.ftl changed</span>
<span class="c-ok">  ✓</span> fluent bundle rebuilt</pre>
            </div>

            <div class="mt-6 pt-3 flex items-start justify-between gap-3 border-t border-t-rule/40">
              <p class="mono text-[10.5px] leading-relaxed text-fg-subtle max-w-[42ch]">
                illustrative output · your run logs the same subsystems
              </p>
              <a href="/docs/getting-started/" class="mono text-[10.5px] text-fg-muted hover:text-fg no-underline shrink-0">get started</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BUILT ON ===== -->
  <div class="border-b border-line">
    <div class="wrap py-7">
      <p class="eyebrow">Built on</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-9 gap-y-3 text-fg-subtle">
        {['Rust', 'GPUI', 'SQLite', 'Fluent', 'AccessKit', 'ed25519', 'keyring', 'tokio'].map((s) => (
          <span class="display text-[19px] tracking-[-.02em]">{s}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- ===== FOUR SUBSYSTEMS ===== -->
  <section class="sect">
    <div class="wrap">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <h2 class="display t-h2 max-w-[16ch]">Four subsystems,<br />designed together.</h2>
        <p class="lead max-w-[38ch] text-[15px]">
          Each one lives behind its own module. <code class="inline">tray</code> and
          <code class="inline">telemetry</code> come out cleanly. Nothing else breaks.
        </p>
      </div>

      <div class="mt-12 ruled grid sm:grid-cols-2 lg:grid-cols-4 reveal">
        {subsystems.map((s) => (
          <article class="p-6 flex flex-col">
            <span class="grid place-items-center w-10 h-10 rounded-lg text-fg-muted border border-line">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d={s.icon} />
              </svg>
            </span>
            <h3 class="text-[17px] font-bold mt-5 tracking-[-.01em]">{s.title}</h3>
            <p class="mono text-[11px] text-fg-subtle mt-1.5">{s.sub}</p>
            <p class="text-[14px] text-fg-muted mt-4 flex-1 leading-relaxed">{s.body}</p>
            <code class="mono block truncate rounded-lg px-3 py-2 mt-5 text-[12px] text-fg-muted border border-line bg-code">
              {s.code}
            </code>
            <a href={s.href} class="alink text-[13px] mt-4">Read the docs</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SIX PAGES ===== -->
  <section id="pages" class="sect-rule">
    <div class="wrap">
      <p class="eyebrow">Not a hello-world</p>
      <h2 class="display t-h2 mt-4 max-w-[18ch]">Six pages, already wired.</h2>
      <p class="lead mt-5 max-w-[56ch]">
        Sidebar routing, theme switching, form validation and the command palette are all live
        the first time you run it. Delete the pages you don't need.
      </p>

      <div class="mt-12 ruled grid sm:grid-cols-2 lg:grid-cols-3 reveal">
        {pages.map((p) => (
          <article class="p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-[16px] font-bold">{p.title}</h3>
              <span class="num text-[11px] text-fg-subtle">{p.n}</span>
            </div>
            <p class="text-[13.5px] text-fg-muted mt-3 leading-relaxed">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== APP PREVIEW ===== -->
  <section class="sect">
    <div class="wrap">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <p class="eyebrow">See it running</p>
          <h2 class="display t-h2 mt-4 max-w-[16ch]">The shell you get on the first run.</h2>
        </div>
        <p class="lead text-[15px] max-w-[40ch]">
          This cycles through five screens of it: sidebar routing, the theme picker, the Cmd+K
          launcher, a localized settings page, and form validation catching a bad email.
        </p>
      </div>

      <div class="mt-12 reveal">
        <AppPreview />
      </div>
    </div>
  </section>

  <!-- ===== WORKFLOW ===== -->
  <section id="workflow" class="sect">
    <div class="wrap">
      <p class="eyebrow">A minute with gpui-starter</p>
      <h2 class="display t-h2 mt-4 max-w-[15ch]">One binary, start to ship.</h2>

      <div class="mt-12 grid lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] gap-8 lg:gap-12 items-start">
        <div>
          <p class="lead text-[15px] max-w-[42ch]">
            Install, develop, test and ship with the same toolchain. Every step below is a real
            command from this repo.
          </p>
          <ol class="list-none p-0 mt-8 m-0" data-stepper>
            {steps.map((s, i) => (
              <li>
                <button
                  class="step w-full text-left px-4 py-3.5 bg-transparent border-0 cursor-pointer transition-colors"
                  data-step={String(i)}
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <div class="flex gap-3.5">
                    <span class="num text-[11px] step-idx">{String(i + 1).padStart(2, '0')}</span>
                    <div>
                      <div class="text-[15px] font-semibold step-title">{s.title}</div>
                      <div class="mono text-[12px] text-fg-muted mt-0.5">{s.cmd}</div>
                      <div class="text-[13.5px] text-fg-muted mt-2 step-desc hidden leading-relaxed">{s.desc}</div>
                    </div>
                  </div>
                </button>
              </li>
            ))}
          </ol>
        </div>

        <div class="codebox">
          <div class="codebar">
            <span data-step-title>terminal · install</span>
            <button
              class="copy-btn bg-transparent border-0 text-inherit cursor-pointer hover:text-fg mono text-[10.5px] uppercase tracking-[.1em]"
              data-copy="cargo run">Copy</button
            >
          </div>
          <div class="codebody min-h-[290px]">
            <pre data-panel="0"><span class="c-p">$ </span>cargo run
<span class="c-dim">   Compiling gpui-starter v{latestVersion}</span>
<span class="c-dim">    Finished `dev` profile</span>
<span class="c-dim">     Running `target/debug/gpui-starter`</span>

<span class="c-ok">  ✓</span> lifecycle       <span class="c-dim">first_run = true</span>
<span class="c-ok">  ✓</span> single-instance <span class="c-dim">lock acquired</span>
<span class="c-ok">  ✓</span> themes          <span class="c-dim">24 loaded, watching ./themes</span>
<span class="c-ok">  ✓</span> i18n            <span class="c-dim">en, zh-CN</span>
<span class="c-ok">  ✓</span> sqlite          <span class="c-dim">app support dir</span>
<span class="c-ok">  ✓</span> tray            <span class="c-dim">menu bar registered</span>

<span class="c-str">  window ready</span></pre>
            <pre class="hidden" data-panel="1"><span class="c-p">$ </span>cp themes/gruvbox.json themes/mine.json
<span class="c-dim">  watcher  themes/mine.json added</span>
<span class="c-ok">  ✓</span> theme reloaded  <span class="c-dim">no restart · 25 themes</span>

<span class="c-p">$ </span>vim i18n/zh-CN/app.ftl
<span class="c-dim">  watcher  i18n/zh-CN/app.ftl changed</span>
<span class="c-ok">  ✓</span> fluent bundle rebuilt</pre>
            <pre class="hidden" data-panel="2"><span class="c-p">$ </span>cargo test
<span class="c-dim">test lifecycle::first_run ............... </span><span class="c-ok">ok</span>
<span class="c-dim">test config::migrate_v1_to_v3 ........... </span><span class="c-ok">ok</span>
<span class="c-dim">test updater::rejects_bad_signature ..... </span><span class="c-ok">ok</span>
<span class="c-dim">test i18n::all_keys_resolve_zh_cn ....... </span><span class="c-ok">ok</span>

<span class="c-ok">test result: ok.</span> <span class="c-dim">0 failed</span></pre>
            <pre class="hidden" data-panel="3"><span class="c-p">$ </span>bash scripts/macos-dev-app.sh
<span class="c-dim">  bundling   GPUI Starter.app</span>
<span class="c-dim">  codesign   adhoc, hardened runtime</span>
<span class="c-ok">  ✓</span> <span class="c-str">target/app/GPUI Starter.app</span>

<span class="c-p">$ </span>open "$(bash scripts/macos-dev-app.sh)"</pre>
            <pre class="hidden" data-panel="4"><span class="c-p">$ </span>just release 0.3.0
<span class="c-dim">  signing    manifest.json (ed25519)</span>
<span class="c-dim">  uploading  gh release v0.3.0</span>
<span class="c-dim">  assets     3 platforms</span>
<span class="c-ok">  ✓</span> clients verify and update on next check</pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS ===== -->
  <section class="sect-rule">
    <div class="wrap">
      <p class="eyebrow">By the numbers</p>
      <h2 class="display t-h2 mt-4 max-w-[18ch]">What ships in the box.</h2>

      <div class="mt-11 ruled grid grid-cols-2 md:grid-cols-4 reveal">
        <div class="p-6">
          <div class="num text-[30px] font-semibold">24</div>
          <div class="mono text-[11px] text-fg-muted mt-2">themes, hot-reloaded</div>
        </div>
        <div class="p-6">
          <div class="num text-[30px] font-semibold">6</div>
          <div class="mono text-[11px] text-fg-muted mt-2">pages wired</div>
        </div>
        <div class="p-6">
          <div class="num text-[30px] font-semibold">2</div>
          <div class="mono text-[11px] text-fg-muted mt-2">locales (en, zh-CN)</div>
        </div>
        <div class="p-6">
          <div class="num text-[30px] font-semibold">0</div>
          <div class="mono text-[11px] text-fg-muted mt-2">webviews shipped</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BUILT-IN APIS ===== -->
  <section id="explorer" class="sect">
    <div class="wrap">
      <p class="eyebrow">Batteries included</p>
      <h2 class="display t-h2 mt-4 max-w-[20ch]">Real APIs, not a feature checklist.</h2>

      <div class="mt-9 flex gap-2 flex-wrap" role="tablist" data-explorer-tabs aria-label="Built-in APIs">
        <button class="pill" role="tab" aria-selected="true" data-tab="routing">Routing</button>
        <button class="pill" role="tab" aria-selected="false" data-tab="themes">Themes</button>
        <button class="pill" role="tab" aria-selected="false" data-tab="i18n">i18n</button>
