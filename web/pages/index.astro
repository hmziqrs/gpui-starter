<script>
  // ---------- hero terminal tabs ----------
  (() => {
    const tabs = document.querySelector<HTMLElement>('[data-heroterm-tabs]');
    if (!tabs) return;
    const paint = () =>
      tabs.querySelectorAll<HTMLElement>('.heroterm-tab').forEach((t) => {
        const on = t.getAttribute('aria-selected') === 'true';
        t.style.background = on ? 'var(--color-canvas)' : 'transparent';
        t.style.color = on ? 'var(--color-fg)' : 'var(--color-fg-muted)';
        t.style.borderBottomColor = on ? 'transparent' : 'var(--color-rule)';
      });
    tabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.heroterm-tab');
      if (!btn) return;
      tabs.querySelectorAll('.heroterm-tab').forEach((t) => t.setAttribute('aria-selected', String(t === btn)));
      document
        .querySelectorAll<HTMLElement>('[data-term-panel]')
        .forEach((p) => p.classList.toggle('hidden', p.dataset.termPanel !== btn.dataset.term));
      paint();
    });
    paint();
  })();

  // ---------- workflow stepper ----------
  (() => {
    const root = document.querySelector<HTMLElement>('[data-stepper]');
    if (!root) return;
    const titles = ['install', 'theme it', 'test', 'bundle', 'ship'];
    const steps = root.querySelectorAll<HTMLElement>('.step');
    const bar = document.querySelector<HTMLElement>('[data-step-title]');
    const paint = () =>
      steps.forEach((s) => {
        const on = s.getAttribute('aria-selected') === 'true';
        s.style.background = on ? 'var(--color-panel)' : 'transparent';
        s.style.borderLeft = on ? '2px solid var(--color-accent)' : '2px solid transparent';
        const idx = s.querySelector<HTMLElement>('.step-idx');
        const title = s.querySelector<HTMLElement>('.step-title');
        const desc = s.querySelector<HTMLElement>('.step-desc');
        if (idx) idx.style.color = on ? 'var(--color-accent)' : 'var(--color-fg-subtle)';
        if (title) title.style.color = on ? 'var(--color-fg)' : 'var(--color-fg-muted)';
        if (desc) desc.classList.toggle('hidden', !on);
      });
    steps.forEach((s) =>
      s.addEventListener('click', () => {
        steps.forEach((o) => o.setAttribute('aria-selected', String(o === s)));
        const i = s.dataset.step;
        document
          .querySelectorAll<HTMLElement>('.codebody > pre[data-panel]')
          .forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== i));
        if (bar) bar.textContent = 'terminal · ' + titles[Number(i)];
        paint();
      })
    );
    paint();
  })();

  // ---------- API explorer ----------
  (() => {
    const tabs = document.querySelector<HTMLElement>('[data-explorer-tabs]');
    const panels = document.querySelector<HTMLElement>('[data-explorer-panels]');
    if (!tabs || !panels) return;
    tabs.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
      if (!btn) return;
      tabs.querySelectorAll('[data-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === btn)));
      panels
        .querySelectorAll<HTMLElement>('[data-panel]')
        .forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== btn.dataset.tab));
    });
  })();
</script>
