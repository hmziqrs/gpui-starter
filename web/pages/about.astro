---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { latestVersion } from '../util/changelog';

const principles = [
  {
    title: 'Real Rust code',
    sub: 'the version that has to compile',
    body: 'Proper error handling, entity lifecycle management, render purity. The kind of code you write when the app has to work.',
  },
  {
    title: 'Everything ships',
    sub: 'working on first run',
    body: 'Themes, i18n, forms, launcher, tray icon. All working the first time you run cargo run.',
  },
  {
    title: 'Battle-tested structure',
    sub: 'from production apps',
    body: 'State tiers, render purity, backpressure handling. Patterns used in production GPUI apps, not ones that looked good in a blog post.',
  },
  {
    title: 'Open source',
    sub: 'MIT licensed',
    body: 'Fork it, change it, ship it. No attribution required, no strings attached.',
  },
];

const mechanics = [
  {
    title: 'AppRoot owns the layout',
    body: 'A resizable sidebar next to a content area. Pages are enum variants; the active one gets rendered.',
  },
  {
    title: 'Sidebar drives navigation',
    body: 'Click a nav item to switch pages. The content area re-renders with the new view. No router, just an enum match.',
  },
  {
    title: 'Cmd+K launcher',
    body: 'A floating popup with fuzzy search. Selections write back through a global, so any part of the app can respond.',
  },
  {
    title: 'Themes reload from disk',
    body: 'ThemeRegistry watches the themes/ directory. Edit a JSON file, save it, and the running app picks up the change immediately.',
  },
  {
    title: 'gpui-query handles async data',
    body: 'Fetch from APIs, cache results, refetch on a timer. The same pattern as TanStack Query, built for GPUI entities.',
  },
  {
    title: 'The updater checks for new versions',
    body: 'ed25519-signed manifests from GitHub Releases. The app prompts the user, downloads in the background, and applies on next launch.',
  },
];
---

<MarketingLayout
  title="About gpui-starter"
  description="Why gpui-starter exists, design principles, how it works, and the person behind the project."
  ogImage="/og/pages/about.png"
>
  <!-- ===== HERO ===== -->
  <section class="border-b border-line">
    <div class="frame py-14 md:py-20">
      <p class="eyebrow">About</p>
      <h1 class="display t-hero mt-5 max-w-[14ch]">
        Copy it. Ship it. <span class="text-accent">Make it yours.</span>
      </h1>
      <p class="lead mt-7 max-w-[58ch]">
        gpui-starter is a working multi-page desktop app you can clone and build on. Every
        feature actually runs. The patterns come from shipping real GPUI software, not from
        imagining what might work.
      </p>
    </div>
  </section>

  <!-- ===== WHY ===== -->
  <section class="sect">
    <div class="wrap grid lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] gap-8 lg:gap-12 items-start">
      <h2 class="display t-h2 max-w-[12ch]">Why it exists.</h2>
      <div class="copy max-w-[64ch]">
        <p>
          GPUI is Zed's GPU-accelerated UI framework for Rust. The API is solid and fast, but
          there is almost nothing written about how to structure a real app with it.
        </p>
        <p>
          gpui-starter started as a personal reference: a working desktop application with
          navigation, themes, i18n, forms, and system integration wired up end to end. Other
          people found it useful, so I cleaned it up and released it.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== PRINCIPLES ===== -->
  <section class="sect-rule">
    <div class="wrap">
      <p class="eyebrow">Design principles</p>
      <h2 class="display t-h2 mt-4 max-w-[18ch]">Four rules the repo keeps.</h2>

      <div class="mt-12 ruled grid sm:grid-cols-2 lg:grid-cols-4 reveal">
        {principles.map((p) => (
          <article class="p-6 flex flex-col">
            <h3 class="text-[17px] font-bold tracking-[-.01em]">{p.title}</h3>
            <p class="mono text-[11px] text-fg-subtle mt-1.5">{p.sub}</p>
            <p class="text-[14px] text-fg-muted mt-4 leading-relaxed flex-1">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="sect">
    <div class="wrap">
      <p class="eyebrow">Mechanics</p>
      <h2 class="display t-h2 mt-4 max-w-[16ch]">How it works.</h2>

      <ol class="list-none p-0 m-0 mt-11 reveal">
        {mechanics.map((m, i) => (
          <li class="flex gap-5 py-5 border-b border-line">
            <span class="num text-[12px] text-accent shrink-0 pt-1">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-[16px] font-bold">{m.title}</h3>
              <p class="text-[14px] text-fg-muted mt-1.5 leading-relaxed max-w-[70ch]">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===== FACTS ===== -->
  <section class="sect-rule">
    <div class="wrap">
      <p class="eyebrow">At a glance</p>

      <div class="mt-8 ruled grid grid-cols-2 md:grid-cols-5 reveal">
        <div class="p-6">
          <div class="num text-[26px] font-semibold">v{latestVersion}</div>
          <div class="mono text-[11px] text-fg-muted mt-2">current version</div>
        </div>
        <div class="p-6">
          <div class="num text-[26px] font-semibold">24</div>
          <div class="mono text-[11px] text-fg-muted mt-2">built-in themes</div>
        </div>
        <div class="p-6">
          <div class="num text-[26px] font-semibold">6</div>
          <div class="mono text-[11px] text-fg-muted mt-2">pages wired</div>
        </div>
        <div class="p-6">
          <div class="num text-[26px] font-semibold">MIT</div>
          <div class="mono text-[11px] text-fg-muted mt-2">license</div>
        </div>
        <div class="p-6">
          <div class="num text-[26px] font-semibold">2024</div>
          <div class="mono text-[11px] text-fg-muted mt-2">rust edition</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== AUTHOR ===== -->
  <section class="sect">
    <div class="wrap">
      <div class="flex flex-col sm:flex-row items-start gap-5 p-7 border border-line max-w-[70ch]">
        <span class="grid place-items-center w-14 h-14 shrink-0 bg-fg text-canvas display text-[22px] rounded-[10px]" aria-hidden="true">h</span>
        <div>
          <h2 class="text-[17px] font-bold">hmziqrs</h2>
          <p class="text-[14px] text-fg-muted mt-2 leading-relaxed">
            Rust developer. I build desktop tools and maintain a few open source projects when
            the compiler lets me.
          </p>
          <div class="flex gap-4 mt-4 text-[13.5px]">
            <a href="https://github.com/hmziqrs" target="_blank" rel="noopener" class="qlink">GitHub</a>
            <a href="https://hmziq.rs" target="_blank" rel="noopener" class="qlink">hmziq.rs</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="sect-rule">
    <div class="wrap text-center">
      <h2 class="display t-h2 max-w-[18ch] mx-auto">Clone it and start deleting.</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/docs/getting-started/" class="btn btn-lg btn-solid">Get started</a>
        <a href="https://github.com/freeoxide/gpui-starter" target="_blank" rel="noopener" class="btn btn-lg btn-accent">
          View on GitHub
        </a>
      </div>
    </div>
  </section>
</MarketingLayout>
