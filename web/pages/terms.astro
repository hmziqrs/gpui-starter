---
import Layout from '../layouts/MarketingLayout.astro';

const title = 'Terms of Use - gpui-starter';
const description =
  'Terms of use for the gpui-starter open-source desktop app boilerplate. MIT license, no warranty, third-party dependency notices, and trademark information.';
const updated = '2026-06-05';

const sections = [
  { id: 'acceptance', label: 'Acceptance' },
  { id: 'software', label: 'The software' },
  { id: 'no-warranty', label: 'No warranty' },
  { id: 'third-party-deps', label: 'Third-party dependencies' },
  { id: 'responsibilities', label: 'Your responsibilities' },
  { id: 'trademarks', label: 'Trademarks' },
  { id: 'modifications', label: 'Modifications' },
  { id: 'governing-law', label: 'Governing law' },
  { id: 'contact', label: 'Contact' },
];
---

<Layout title={title} description={description} ogImage="/og/pages/terms.png">
  <!-- HERO -->
  <section class="border-b border-line">
    <div class="frame py-14 md:py-20">

      <div>
        <p class="eyebrow">Legal</p>
        <h1
          class="display t-hero mt-5"
        >
          Terms of <span class="text-accent">Use.</span>
        </h1>
        <p class="mono text-[12px] text-fg-subtle mt-5">
          Last updated <time datetime={updated}>{updated}</time>
        </p>
        <p class="lead mt-7 max-w-[62ch]">
          Short version: gpui-starter is free, open source under the MIT license,
          and provided as-is with no warranty. You own what you build. Keep the
          license notice intact and respect the licenses of bundled dependencies.
        </p>
      </div>
    </div>
  </section>

  <!-- TWO COLUMN: TOC + CONTENT -->
  <section class="sect">
    <div
      class="wrap grid lg:grid-cols-[16rem_1fr] gap-10 items-start"
    >
      <!-- Sticky TOC -->
      <aside class="lg:sticky lg:top-28 self-start">
        <div class="border border-line p-5">
          <h2
            class="eyebrow mb-3"
          >
            Contents
          </h2>
          <nav>
            <ol class="space-y-1.5 list-none p-0 m-0 mono">
              {
                sections.map((s, i) => (
                  <li>
                    <a
                      href={`#${s.id}`}
                      class="flex items-baseline gap-3 px-2 py-1.5 text-[13.5px] text-fg-muted hover:text-fg hover:bg-panel no-underline transition-colors"
                    >
                      <span class="num text-[11px] text-fg-subtle w-5 shrink-0">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <span>{s.label}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </div>
      </aside>

      <!-- Content -->
      <article class="space-y-px">
        <div class="border border-line p-7 sm:p-9">
          <h2
            id="acceptance"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">01</span>Acceptance
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem]">
            By using gpui-starter or browsing this website, you agree to these
            terms. If you disagree with any part, stop using the software and
            close the site.
          </p>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="software"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">02</span>The software
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem] mb-4">
            gpui-starter is released under the <strong class="text-fg"
              >MIT License</strong
            >. The full text lives in the <a
              href="https://github.com/freeoxide/gpui-starter/blob/master/LICENSE"
              target="_blank"
              rel="noopener"
              class="text-accent no-underline hover:underline">LICENSE file</a
            > in the repository. You can:
          </p>
          <ul class="space-y-2 list-none p-0 m-0">
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Use the software for any purpose, commercial or
              non-commercial
            </li>
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Modify, fork, and redistribute it
            </li>
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Bundle it into your own products
            </li>
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Sell copies of it (with the MIT license preserved)
            </li>
          </ul>
          <p class="mt-4 text-fg-muted leading-relaxed text-[0.95rem]">
            The only requirement: include the copyright notice and license text
            in any copies or substantial portions you redistribute.
          </p>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="no-warranty"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">03</span>No warranty
          </h2>
          <div
            class="p-4 border-l-2 border-l-accent bg-panel mb-4"
          >
            <p
              class="font-mono text-[11px] uppercase tracking-wider text-accent-300 mb-1"
            >
              As-is
            </p>
            <p class="text-fg-muted text-[0.93rem] leading-relaxed">
              THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND,
              EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
              MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND
              NON-INFRINGEMENT.
            </p>
          </div>
          <p class="text-fg-muted leading-relaxed text-[0.95rem]">
            In plain terms: this is a solo-maintained project. I ship working
            code and fix bugs when I can, but there are no guarantees it will
            work for your setup, stay bug-free, or receive updates indefinitely.
            Test before relying on it for anything important.
          </p>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="third-party-deps"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">04</span>Third-party
            dependencies
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem] mb-4">
            gpui-starter builds on these open-source projects:
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a
              href="https://github.com/zed-industries/zed"
              target="_blank"
              rel="noopener noreferrer"
              class="block p-4 rounded-xl border border-line bg-accent/[0.03] hover:border-rule hover:bg-accent/[0.06] no-underline transition-colors"
            >
              <div class="font-semibold text-fg">GPUI</div>
              <div class="text-xs text-fg-subtle mt-1 font-mono">
                Zed Industries, GPU-accelerated UI
              </div>
            </a>
            <a
              href="https://github.com/longbridge/gpui-component"
              target="_blank"
              rel="noopener noreferrer"
              class="block p-4 rounded-xl border border-line bg-accent/[0.03] hover:border-rule hover:bg-accent/[0.06] no-underline transition-colors"
            >
              <div class="font-semibold text-fg">gpui-component</div>
              <div class="text-xs text-fg-subtle mt-1 font-mono">
                Longbridge, UI component library
              </div>
            </a>
            <a
              href="https://github.com/nickel-org/es-fluent"
              target="_blank"
              rel="noopener noreferrer"
              class="block p-4 rounded-xl border border-line bg-accent/[0.03] hover:border-rule hover:bg-accent/[0.06] no-underline transition-colors"
            >
              <div class="font-semibold text-fg">es-fluent</div>
              <div class="text-xs text-fg-subtle mt-1 font-mono">
                Fluent localization for Rust
              </div>
            </a>
            <a
              href="https://github.com/nickel-org/koruma"
              target="_blank"
              rel="noopener noreferrer"
              class="block p-4 rounded-xl border border-line bg-accent/[0.03] hover:border-rule hover:bg-accent/[0.06] no-underline transition-colors"
            >
              <div class="font-semibold text-fg">koruma</div>
              <div class="text-xs text-fg-subtle mt-1 font-mono">
                Composable validation with derive macros
              </div>
            </a>
          </div>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="responsibilities"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">05</span>Your
            responsibilities
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem] mb-4">
            If you use gpui-starter, you agree to:
          </p>
          <ul class="space-y-2 list-none p-0 m-0">
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Own what you build. Your code is your responsibility
            </li>
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Not use it for anything illegal
            </li>
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Respect the licenses of dependencies you bundle
            </li>
            <li class="flex gap-3 text-[0.93rem] text-fg-muted">
              <span class="shrink-0 mt-2 w-1.5 h-1.5 rounded-full bg-accent"
              ></span>Understand this is maintained by an independent
              developer, not a company
            </li>
          </ul>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="trademarks"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">06</span>Trademarks
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem]">
            GPUI is a trademark of Zed Industries, Inc. <strong class="text-fg"
              >gpui-starter is an independent open-source project.</strong
            > It has no affiliation with, endorsement from, or sponsorship by
            Zed Industries. All other trademarks belong to their respective
            owners.
          </p>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="modifications"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">07</span>Modifications
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem]">
            These terms may change. Material updates bump the "last updated"
            date at the top. This page is open source, so every revision is
            auditable in the <a
              href="https://github.com/freeoxide/gpui-starter/commits/master/web/pages/terms.astro"
              target="_blank"
              rel="noopener"
              class="text-accent no-underline hover:underline">git history</a
            >. Using the software or site after a change means you accept the
            updated terms.
          </p>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="governing-law"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">08</span>Governing law
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem]">
            These terms are governed by the laws of the maintainer's primary
            jurisdiction. If any provision is found unenforceable, the rest
            stays in effect. These terms do not limit any rights you have under
            mandatory consumer protection laws in your own jurisdiction.
          </p>
        </div>

        <div class="border border-line p-7 sm:p-9">
          <h2
            id="contact"
            class="display scroll-mt-28 text-[1.4rem] sm:text-[1.6rem] mb-4"
          >
            <span class="num text-accent text-[0.7em] mr-2.5">09</span>Contact
          </h2>
          <p class="text-fg-muted leading-relaxed text-[0.95rem]">
            Got legal or licensing questions? Open an <a
              href="https://github.com/freeoxide/gpui-starter/issues"
              target="_blank"
              rel="noopener"
              class="text-accent no-underline hover:underline">issue on GitHub</a
            > or reach out via the channels on <a
              href="https://hmziq.rs"
              target="_blank"
              rel="noopener"
              class="text-accent no-underline hover:underline">hmziq.rs</a
            >.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="https://github.com/freeoxide/gpui-starter"
              target="_blank"
              rel="noopener"
              class="btn btn-lg btn-accent"
            >
              View source on GitHub
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg
              >
            </a>
            <a href="/privacy/" class="btn btn-lg btn-solid">Read the privacy policy</a>
          </div>
        </div>
      </article>
    </div>
  </section>
</Layout>
