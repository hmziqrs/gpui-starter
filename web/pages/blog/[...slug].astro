---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'fs';
import { join } from 'path';
import Layout from '../../layouts/MarketingLayout.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { author, formatDate, readingTime } from '../../util/author';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
const localAudioPath = join(process.cwd(), 'audio', `${post.id}.mp3`);
const audioSrc = post.data.audio ?? (existsSync(localAudioPath) ? `/audio/${post.id}.mp3` : null);
---

<Layout
  title={`${post.data.title} - gpui-starter | Rust Desktop Development Blog`}
  description={post.data.description}
  ogType="article"
  ogImage={`/og/blog/${post.id}.png`}
  articlePublishedTime={post.data.date}
  articleTags={post.data.tags}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    author: {
      '@type': 'Person',
      name: 'hmziqrs',
      url: 'https://hmziq.rs',
    },
    publisher: {
      '@type': 'Organization',
      name: 'gpui-starter',
      url: 'https://gpui-starter.freeoxide.com',
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://gpui-starter.freeoxide.com/blog/${post.id}/`,
    },
  }}
>
  <article>
    <!-- ===== HEADER ===== -->
    <section class="border-b border-line">
      <div class="frame py-12 md:py-16">
        <a href="/blog/" class="mono text-[11.5px] tracking-[.12em] uppercase text-fg-muted hover:text-fg no-underline inline-flex items-center gap-2 transition-colors">
          <span aria-hidden="true">&larr;</span> Back to blog
        </a>

        <div class="flex flex-wrap items-center gap-2.5 mono text-[11px] text-fg-subtle mt-8">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          {post.data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span class="flex gap-2 flex-wrap">
                {post.data.tags.map((t) => (
                  <span class="text-accent">#{t}</span>
                ))}
              </span>
            </>
          )}
        </div>

        <h1 class="display mt-4 text-[clamp(2rem,4.5vw,3.25rem)] max-w-[22ch]">{post.data.title}</h1>

        <p class="lead mt-6 max-w-[62ch]">{post.data.description}</p>

        <div class="flex items-center gap-3 mt-8">
          <img src={author.avatar.dark} alt={author.name} width="40" height="40" class="rounded-full border border-line" />
          <div>
            <a href={author.url} target="_blank" rel="noopener" class="alink font-semibold text-[14px] block">{author.name}</a>
            <span class="mono text-[11px] text-fg-subtle">@{author.twitterHandle}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== BODY ===== -->
    <div class="wrap py-14 md:py-20 grid lg:grid-cols-[minmax(0,1fr)_15rem] gap-10 lg:gap-14 items-start">
      <div class="min-w-0 max-w-[72ch]">
        {audioSrc && <AudioPlayer src={audioSrc} title={post.data.title} />}

        <div class="copy">
          <Content />
        </div>
      </div>

      <aside class="hidden lg:block lg:sticky lg:top-28 border-l border-line pl-6">
        <p class="eyebrow">Published</p>
        <time class="mono text-[12px] text-fg-muted block mt-2" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>

        <p class="eyebrow mt-7">Length</p>
        <p class="mono text-[12px] text-fg-muted mt-2">{minutes} min read</p>

        {post.data.tags.length > 0 && (
          <>
            <p class="eyebrow mt-7">Tags</p>
            <ul class="list-none p-0 m-0 mt-2 space-y-1">
              {post.data.tags.map((t) => (
                <li class="mono text-[12px] text-fg-muted">
                  <span class="text-accent">#</span>{t}
                </li>
              ))}
            </ul>
          </>
        )}

        <p class="eyebrow mt-7">Written by</p>
        <a href={author.url} target="_blank" rel="noopener" class="qlink text-[13px] block mt-2">
          {author.name}
        </a>

        <a href="/blog/" class="qlink mono text-[11px] tracking-[.12em] uppercase block mt-8">
          &larr; All articles
        </a>
      </aside>
    </div>

    <!-- ===== AUTHOR ===== -->
    <section class="sect">
      <div class="wrap">
        <div class="flex flex-col sm:flex-row items-start gap-5 p-7 border border-line">
          <img src={author.avatar.dark} alt={author.name} width="56" height="56" class="rounded-full border border-line shrink-0" />
          <div class="flex-1">
            <div class="flex items-baseline gap-2.5 flex-wrap">
              <a href={author.url} target="_blank" rel="noopener" class="alink font-semibold text-[15px]">{author.name}</a>
              <span class="mono text-[11px] text-fg-subtle">@{author.twitterHandle}</span>
            </div>
            <p class="text-[13.5px] text-fg-muted mt-2 mb-4 leading-relaxed max-w-[62ch]">{author.bio}</p>
            <div class="flex flex-wrap gap-2">
              {author.socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.platform}
                  title={s.platform}
                  class="inline-flex items-center justify-center w-8 h-8 border border-line text-fg-subtle no-underline hover:text-fg hover:border-rule transition-colors"
                >
                  <SocialIcon platform={s.platform} size={15} />
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>
