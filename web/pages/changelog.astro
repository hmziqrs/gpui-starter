---
import Layout from '../layouts/MarketingLayout.astro';
import { releases, type Release } from '../util/changelog';

function md(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong class="text-fg font-semibold">$1</strong>')
    .replace(/`([^`]+)`/g, '<code class="inline">$1</code>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="alink">$1</a>');
}

// Section labels are rendered as monospace eyebrows; only the accent marker varies.
const accented = new Set(['Added', 'Features']);

const latest = releases[0];
const past = releases.slice(1);
const total = releases.length;

function count(r: Release, label: string): number {
  return r.sections.find((s) => s.label === label)?.items.length ?? 0;
}

const totalAdds = releases.reduce((n, r) => n + count(r, 'Added') + count(r, 'Features'), 0);
const totalFixes = releases.reduce((n, r) => n + count(r, 'Fixed'), 0);
const totalChanges = releases.reduce((n, r) => n + count(r, 'Changed'), 0);

function summarize(r: Release) {
  return r.sections.map((s) => ({ label: s.label, count: s.items.length }));
}

function daysBetween(a: string, b: string): number {
  return Math.max(0, Math.round((new Date(b).getTime() - new Date(a).getTime()) / (1000 * 60 * 60 * 24)));
}

function formatDate(dateStr: string): string {
  try {
    return new Date(dateStr).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

function getHighlight(r: Release): { title: string; desc: string } | null {
  const added = r.sections.find((s) => s.label === 'Added') ?? r.sections.find((s) => s.label === 'Features');
  if (!added || added.items.length === 0) return null;
  const first = added.items[0];
  const boldMatch = first.text.match(/\*\*([^*]+)\*\*/);
  const title = boldMatch?.[1] ?? first.text.split(':')[0]?.split('.')[0] ?? 'New features';
  const rest = first.text.replace(/\*\*[^*]+\*\*/, '').replace(/^[:\s-]+/, '');
  return { title, desc: rest || 'See full details below.' };
}

const highlight = latest ? getHighlight(latest) : null;
---

<Layout
  title="Changelog - gpui-starter"
  ogImage="/og/pages/changelog.png"
  description="Release history for gpui-starter: every feature, fix, and change from v0.1 to today"
>
  <!-- ===== HERO ===== -->
  <section class="border-b border-line">
    <div class="frame py-14 md:py-20">
      <p class="eyebrow">Changelog</p>
      <h1 class="display t-hero mt-5">
        What's <span class="text-accent">new.</span>
      </h1>
      <p class="lead mt-7 max-w-[52ch]">Every release, every change. From v0.1 to today.</p>
    </div>
  </section>

  <!-- ===== TOTALS ===== -->
  <div class="border-b border-line">
    <div class="wrap">
      <div class="ruled bleed grid grid-cols-2 md:grid-cols-4 border-t-0">
        <div class="py-6">
          <div class="num text-[28px] font-semibold">{total}</div>
          <div class="mono text-[11px] text-fg-muted mt-2">releases</div>
        </div>
        <div class="py-6">
          <div class="num text-[28px] font-semibold">{totalAdds}</div>
          <div class="mono text-[11px] text-fg-muted mt-2">features</div>
        </div>
        <div class="py-6">
          <div class="num text-[28px] font-semibold">{totalChanges}</div>
          <div class="mono text-[11px] text-fg-muted mt-2">changes</div>
        </div>
        <div class="py-6">
          <div class="num text-[28px] font-semibold">{totalFixes}</div>
          <div class="mono text-[11px] text-fg-muted mt-2">fixes</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== LATEST RELEASE ===== -->
  {latest && (
    <section class="sect">
      <div class="wrap">
        <article class="border border-rule p-7 sm:p-10">
          <div class="flex flex-wrap items-end justify-between gap-y-4 gap-x-6">
            <div>
              <span class="tag">Latest release</span>
              <h2 class="display text-[clamp(2.4rem,6vw,4rem)] mt-4">
                <span class="mono text-fg-subtle text-[0.4em] align-top mr-1">v</span>{latest.version}
              </h2>
              <p class="mono text-[12px] text-fg-muted mt-2">
                <time datetime={latest.date}>{formatDate(latest.date)}</time>
                {past.length > 0 && (
                  <span class="text-fg-subtle ml-2">
                    ({daysBetween(past[0]?.date ?? latest.date, latest.date)} days since last)
                  </span>
                )}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              {summarize(latest).map(({ label, count: n }) => (
                <span class="pill">
                  {label}
                  <span class="num text-[11px] text-fg-subtle">{n}</span>
                </span>
              ))}
            </div>
          </div>

          {highlight && (
            <div class="mt-8 p-5 bg-panel border-l-2 border-l-accent">
              <h3 class="text-[15px] font-bold">{highlight.title}</h3>
              <p class="text-[13.5px] text-fg-muted mt-1 leading-relaxed" set:html={md(highlight.desc)} />
            </div>
          )}

          <div class="mt-10 space-y-10">
            {latest.sections.map((section) => (
              <div>
                <div class="flex items-center gap-3">
                  <span class={accented.has(section.label) ? 'eyebrow !text-accent' : 'eyebrow'}>{section.label}</span>
                  <span class="num text-[11px] text-fg-subtle">{section.items.length}</span>
                  <div class="flex-1 h-px bg-line" />
                </div>
                <ul class="list-none p-0 m-0 mt-4">
                  {section.items.map((item) => (
                    <li class="text-[14.5px] text-fg-muted leading-relaxed py-2 border-b border-line">
                      <span set:html={md(item.text)} />
                      {item.subItems.length > 0 && (
                        <ul class="list-none p-0 mt-2 ml-1 pl-4 border-l border-line space-y-1">
                          {item.subItems.map((sub) => (
                            <li class="text-[13px] text-fg-subtle leading-relaxed" set:html={md(sub)} />
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- ===== PAST RELEASES ===== -->
  {past.length > 0 && (
    <section class="sect-rule">
      <div class="wrap">
        <div class="flex items-baseline justify-between gap-4 flex-wrap">
          <div class="flex items-baseline gap-3">
            <p class="eyebrow">Past releases</p>
            <span class="num text-[11px] text-fg-subtle">{past.length}</span>
          </div>
          <button id="expand-all" type="button" class="pill">Expand all</button>
        </div>

        <div class="mt-8">
          {past.map((release, ri) => {
            const totalEntries = release.sections.reduce((n, s) => n + s.items.length, 0);
            const days = daysBetween(release.date, releases[ri + 1]?.date ?? release.date);
            return (
              <details class="release-card border-b border-line">
                <summary class="cursor-pointer list-none py-5 flex items-center gap-4 sm:gap-6 select-none">
                  <svg
                    class="chev shrink-0 text-fg-subtle transition-transform duration-300"
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg
                  >

                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 shrink-0">
                    <span class="display text-[20px]">
                      <span class="mono text-fg-subtle text-[12px]">v</span>{release.version}
                    </span>
                    <time class="mono text-[11px] text-fg-muted" datetime={release.date}>{formatDate(release.date)}</time>
                    {days > 0 && <span class="mono text-[10px] text-fg-subtle hidden sm:inline">({days}d cycle)</span>}
                  </div>

                  <div class="hidden md:flex flex-1 flex-wrap gap-1.5 justify-end">
                    {summarize(release).map(({ label, count: n }) => (
                      <span class="mono text-[10px] uppercase tracking-[.1em] text-fg-subtle border border-line px-2 py-0.5">
                        {label} {n}
                      </span>
                    ))}
                  </div>

                  <span class="md:hidden ml-auto num text-[11px] text-fg-subtle">
                    {totalEntries} {totalEntries === 1 ? 'entry' : 'entries'}
                  </span>
                </summary>

                <div class="release-body pb-8 pl-0 sm:pl-8 space-y-8">
                  {release.sections.map((section) => (
                    <div>
                      <div class="flex items-center gap-3">
                        <span class={accented.has(section.label) ? 'eyebrow !text-accent' : 'eyebrow'}>{section.label}</span>
                        <span class="num text-[11px] text-fg-subtle">{section.items.length}</span>
                        <div class="flex-1 h-px bg-line" />
                      </div>
                      <ul class="list-none p-0 m-0 mt-3">
                        {section.items.map((item) => (
                          <li class="text-[14px] text-fg-muted leading-relaxed py-1.5">
                            <span set:html={md(item.text)} />
                            {item.subItems.length > 0 && (
                              <ul class="list-none p-0 mt-1.5 ml-1 pl-3 border-l border-line space-y-1">
                                {item.subItems.map((sub) => (
                                  <li class="text-[12.5px] text-fg-subtle leading-relaxed" set:html={md(sub)} />
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </details>
            );
          })}
        </div>

        <div class="mt-14 text-center">
          <p class="lead text-[15px] mb-6">Want to follow along between releases?</p>
          <div class="flex gap-3 justify-center flex-wrap">
            <a href="https://github.com/freeoxide/gpui-starter/releases" target="_blank" rel="noopener" class="btn btn-lg btn-accent">
              View on GitHub
            </a>
            <a href="/docs/getting-started/" class="btn btn-lg btn-solid">Get started</a>
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>

<style is:global>
  .release-card summary::-webkit-details-marker {
    display: none;
  }
  .release-card[open] .chev {
    transform: rotate(90deg);
    color: var(--color-accent);
  }
  .release-card summary:hover .chev {
    color: var(--color-fg);
  }
  .release-card .release-body {
    animation: release-open 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes release-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .release-card .release-body {
      animation: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('expand-all');
  if (btn) {
    btn.addEventListener('click', () => {
      const cards = document.querySelectorAll('.release-card') as NodeListOf<HTMLDetailsElement>;
      const anyClosed = Array.from(cards).some((d) => !d.open);
      cards.forEach((d) => {
        d.open = anyClosed;
      });
      btn.textContent = anyClosed ? 'Collapse all' : 'Expand all';
    });
  }
</script>
