---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/MarketingLayout.astro';

const entries = (await getCollection('faq')).toSorted((a, b) => a.data.order - b.data.order);
const categories = [...new Set(entries.map((e) => e.data.category))];

const catMeta: Record<string, { label: string; icon: string }> = {
  'Getting Started': {
    label: 'Getting Started',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>',
  },
  'Features': {
    label: 'Features',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"/>',
  },
  'Advanced': {
    label: 'Advanced',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.049.58.025 1.193-.14 1.743"/>',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((e) => ({
    '@type': 'Question',
    name: e.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: e.data.description,
    },
  })),
};

const faqCount = entries.length;
---

<Layout
  title="FAQ: gpui-starter Answers | GPUI Desktop App Boilerplate"
  description={`Common questions about gpui-starter answered: GPUI basics, themes, i18n, forms, command launcher, data storage, and more. ${faqCount} entries across getting started, features, and advanced topics.`}
  jsonLd={faqJsonLd}
>
  <section class="relative z-10 pt-36 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <span class="eyebrow">// {faqCount} questions answered</span>
      <h1
        class="reveal mt-5 text-4xl sm:text-5xl font-extrabold tracking-[-0.02em] leading-[1.05]"
      >
        Questions we get <span class="gradient-text">asked a lot.</span>
      </h1>
      <p class="reveal mt-5 text-text-dim max-w-2xl text-lg leading-relaxed">
        From "what is GPUI?" to SQLite internals. If your question is not here, try the
        <a href="/docs/" class="text-amber no-underline hover:underline">docs</a>,
        check the <a href="/blog/" class="text-amber no-underline hover:underline">blog</a>, or
        <a href="https://github.com/hmziqrs/gpui-boilerplate/issues" target="_blank" rel="noopener" class="text-amber no-underline hover:underline">open an issue</a>.
      </p>
    </div>
  </section>

  <section class="relative z-10 pb-32 px-6">
    <div class="max-w-4xl mx-auto space-y-16">
      {categories.map((cat) => {
        const meta = catMeta[cat];
        const catEntries = entries.filter((e) => e.data.category === cat);
        return (
          <div>
            <h2 class="reveal flex items-center gap-2.5 text-xs font-mono uppercase tracking-[0.2em] text-amber mb-6">
              {meta && (
                <svg class="w-4 h-4 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={meta.icon} />
              )}
              <span>{cat}</span>
              <span class="ml-1 text-text-mute normal-case tracking-normal font-sans text-[11px] font-normal">
                {catEntries.length} {catEntries.length === 1 ? 'question' : 'questions'}
              </span>
            </h2>
            <div class="space-y-3">
              {catEntries.map((entry) => (
                <a
                  href={`/faq/${entry.id}/`}
                  class="reveal block glass rounded-2xl p-6 no-underline transition-all duration-200 hover:border-edge-hover group"
                >
                  <div class="flex items-start gap-4">
                    <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-amber/60 group-hover:bg-amber transition-colors" aria-hidden="true"></span>
                    <div class="min-w-0">
                      <h3 class="text-lg font-bold tracking-tight mb-1.5 group-hover:text-amber transition-colors leading-snug">
                        {entry.data.question}
                      </h3>
                      <p class="text-sm text-text-dim leading-relaxed line-clamp-2">
                        {entry.data.description}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}

      <div class="reveal pt-8 border-t border-edge/50">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <p class="text-text text-sm font-semibold">Still have questions?</p>
            <p class="text-text-mute text-sm mt-0.5">
              Check the docs, browse the blog, or ask on GitHub.
            </p>
          </div>
          <div class="flex gap-3 flex-shrink-0">
            <a
              href="https://github.com/hmziqrs/gpui-boilerplate/issues"
              target="_blank"
              rel="noopener"
              class="btn-primary"
            >
              Open an issue
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </a>
            <a href="/docs/getting-started/" class="btn-secondary">Read the docs</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
