---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/MarketingLayout.astro';

const entries = (await getCollection('faq')).toSorted((a, b) => a.data.order - b.data.order);
const categories = [...new Set(entries.map((e) => e.data.category))];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((e) => ({
    '@type': 'Question',
    name: e.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: e.data.description,
    },
  })),
};

const faqCount = entries.length;
---

<Layout
  title="FAQ: gpui-starter Answers | GPUI Desktop App Boilerplate"
  description={`Common questions about gpui-starter answered: GPUI basics, themes, i18n, forms, command launcher, data storage, and more. ${faqCount} entries across getting started, features, and advanced topics.`}
  ogImage="/og/pages/faq.png"
  jsonLd={faqJsonLd}
>
  <!-- ===== HEADER ===== -->
  <section class="border-b border-line">
    <div class="frame py-14 md:py-20">
      <p class="eyebrow">{faqCount} questions answered</p>
      <h1 class="display t-hero mt-5 max-w-[16ch]">
        Questions we get <span class="text-accent">asked a lot.</span>
      </h1>
      <p class="lead mt-7 max-w-[58ch]">
        From "what is GPUI?" to SQLite internals. If your question is not here, try the
        <a href="/docs/getting-started/" class="alink">docs</a>, check the
        <a href="/blog/" class="alink">blog</a>, or
        <a href="https://github.com/freeoxide/gpui-starter/issues" target="_blank" rel="noopener" class="alink">open an issue</a>.
      </p>
    </div>
  </section>

  <!-- ===== QUESTIONS ===== -->
  {categories.map((cat) => {
    const catEntries = entries.filter((e) => e.data.category === cat);
    return (
      <section class="sect">
        <div class="wrap">
          <div class="flex items-baseline gap-3 flex-wrap">
            <p class="eyebrow">{cat}</p>
            <span class="mono text-[11px] text-fg-subtle">
              {catEntries.length} {catEntries.length === 1 ? 'question' : 'questions'}
            </span>
          </div>

          <div class="mt-8 ruled grid sm:grid-cols-2 lg:grid-cols-3">
            {catEntries.map((entry) => (
              <a href={`/faq/${entry.id}/`} class="flex flex-col h-full p-6 no-underline text-fg hover:bg-panel transition-colors">
                <h2 class="text-[15.5px] font-bold tracking-[-.01em] leading-snug">{entry.data.question}</h2>
                <p class="text-[13.5px] text-fg-muted mt-3 leading-relaxed flex-1">{entry.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ===== CTA ===== -->
  <section class="sect-rule">
    <div class="wrap flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div>
        <h2 class="display t-h3">Still have questions?</h2>
        <p class="lead text-[15px] mt-2">Check the docs, browse the blog, or ask on GitHub.</p>
      </div>
      <div class="flex gap-3 flex-wrap shrink-0">
        <a href="https://github.com/freeoxide/gpui-starter/issues" target="_blank" rel="noopener" class="btn btn-accent">
          Open an issue
        </a>
        <a href="/docs/getting-started/" class="btn btn-solid">Read the docs</a>
      </div>
    </div>
  </section>
</Layout>
