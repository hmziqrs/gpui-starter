---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/MarketingLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('faq');
  const sorted = entries.toSorted((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : null,
      next: i < sorted.length - 1 ? sorted[i + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.data.description,
    },
  }],
};
---

<Layout
  title={`${entry.data.question} - gpui-starter FAQ`}
  description={entry.data.description}
  ogType="article"
  ogImage={`/og/faq/${entry.id}.png`}
  jsonLd={faqJsonLd}
>
  <article>
    <!-- ===== HEADER ===== -->
    <section class="border-b border-line">
      <div class="frame py-12 md:py-16">
        <a href="/faq/" class="mono text-[11.5px] tracking-[.12em] uppercase text-fg-muted hover:text-fg no-underline inline-flex items-center gap-2 transition-colors">
          <span aria-hidden="true">&larr;</span> Back to FAQ
        </a>

        <p class="eyebrow mt-8">{entry.data.category}</p>

        <h1 class="display mt-4 text-[clamp(1.9rem,4vw,3rem)] max-w-[22ch]">{entry.data.question}</h1>

        <p class="lead mt-6 max-w-[62ch]">{entry.data.description}</p>
      </div>
    </section>

    <!-- ===== ANSWER ===== -->
    <div class="wrap py-14 md:py-20 grid lg:grid-cols-[minmax(0,1fr)_15rem] gap-10 lg:gap-14 items-start">
      <div class="min-w-0 max-w-[72ch] copy">
        <Content />
      </div>

      <aside class="hidden lg:block lg:sticky lg:top-28 border-l border-line pl-6">
        <p class="eyebrow">Category</p>
        <p class="mono text-[12px] text-fg-muted mt-2">{entry.data.category}</p>

        <p class="eyebrow mt-7">More</p>
        <ul class="list-none p-0 m-0 mt-2 space-y-1.5 text-[13px]">
          <li><a href="/faq/" class="qlink">All questions</a></li>
          <li><a href="/docs/getting-started/" class="qlink">Documentation</a></li>
          <li><a href="/blog/" class="qlink">Blog</a></li>
        </ul>

        <a
          href="https://github.com/freeoxide/gpui-starter/issues"
          target="_blank"
          rel="noopener"
          class="qlink mono text-[11px] tracking-[.12em] uppercase block mt-8">Ask on GitHub &nearr;</a
        >
      </aside>
    </div>

    <!-- ===== PREV / NEXT ===== -->
    <section class="sect">
      <div class="wrap">
        <div class="ruled grid sm:grid-cols-2">
          {prev ? (
            <a href={`/faq/${prev.id}/`} class="block p-6 no-underline text-fg hover:bg-panel transition-colors">
              <span class="mono text-[11px] text-fg-subtle block">Previous</span>
              <span class="text-[15px] font-semibold mt-1.5 block">{prev.data.question}</span>
            </a>
          ) : (
            <div class="p-6" />
          )}
          {next ? (
            <a href={`/faq/${next.id}/`} class="block p-6 no-underline text-fg hover:bg-panel transition-colors sm:text-right">
              <span class="mono text-[11px] text-fg-subtle block">Next</span>
              <span class="text-[15px] font-semibold mt-1.5 block">{next.data.question}</span>
            </a>
          ) : (
            <div class="p-6" />
          )}
        </div>
      </div>
    </section>
  </article>
</Layout>
