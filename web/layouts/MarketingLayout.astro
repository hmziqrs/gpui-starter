---
import { latestVersion, latestHighlight } from '../util/changelog';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  articlePublishedTime?: Date;
  articleModifiedTime?: Date;
  articleTags?: string[];
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const SITE = 'https://gpui-starter.freeoxide.com';
const DEFAULT_TITLE = 'gpui-starter: Rust Desktop App Boilerplate with GPUI, SQLite, and Auto-Update';
const DEFAULT_DESC =
  'Ship Rust desktop apps faster. GPUI starter includes 21 themes, i18n (en + zh-CN), form validation, Cmd+K command palette, macOS tray, SQLite persistence, OS keyring storage, Ed25519-signed auto-update, gpui-query async state management, and AccessKit accessibility. MIT licensed.';
const DEFAULT_OG_IMAGE = `${SITE}/og-image.png`;

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  articlePublishedTime,
  articleModifiedTime,
  articleTags = [],
  jsonLd: customJsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).toString();
const navSeg = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;

const crumbs = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((seg, i, arr) => ({
    name: seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()).replace(/\bGpui\b/g, 'GPUI'),
    url: '/' + arr.slice(0, i + 1).join('/') + '/',
  }));

const schemaApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'gpui-starter',
  url: SITE,
  description: DEFAULT_DESC,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS',
  featureList: [
    '21 built-in UI themes with hot-reload',
    'i18n with English and Simplified Chinese (es-fluent)',
    'Form validation via gpui-form and koruma',
    'Cmd+K command palette launcher',
    'macOS system tray integration',
    'SQLite persistence with rusqlite',
    'Secure credential storage via OS keyring',
    'Ed25519-signed auto-update system with background checks',
    'gpui-query: TanStack Query-inspired async state management',
    'Undo and redo support',
    'Single-instance enforcement',
    'Desktop notifications',
    'Custom titlebar with drag regions',
    'Global keyboard shortcuts',
    'AccessKit accessibility',
    'Telemetry with opt-in consent gate',
    'Crash report generation and storage',
    'Diagnostics panel',
    'Multi-page navigation with sidebar',
    'WebSocket connectivity',
    'Error boundaries with recovery',
    'gpui-component and gpui-form vendored libraries',
  ],
  screenshot: `${SITE}/og-image.png`,
  softwareVersion: latestVersion,
  installUrl: 'https://github.com/freeoxide/gpui-starter#installation',
  downloadUrl: 'https://github.com/freeoxide/gpui-starter/releases',
  inLanguage: ['en', 'zh-CN'],
  programmingLanguage: 'Rust',
  keywords: [
    'GPUI',
    'Rust',
    'desktop app',
    'boilerplate',
    'SQLite',
    'auto-update',
    'i18n',
    'themes',
    'AccessKit',
    'command palette',
    'gpui-query',
    'async state management',
    'error boundaries',
    'WebSocket',
    'crash reporting',
  ],
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Person',
    name: 'hmziqrs',
    url: 'https://hmziq.rs',
  },
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: 'https://github.com/freeoxide/gpui-starter',
  sameAs: 'https://github.com/freeoxide/gpui-starter',
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      item: { '@id': SITE, name: 'Home' },
    },
    ...crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      item: { '@id': `${SITE}${c.url}`, name: c.name },
    })),
  ],
};

const jsonLdArray = [schemaApp, schemaBreadcrumb];
if (customJsonLd) jsonLdArray.push(customJsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0a0c" />
    <link rel="alternate" type="application/rss+xml" title="gpui-starter Blog (RSS)" href={`${SITE}/feed.xml`} />
    <link rel="alternate" type="application/atom+xml" title="gpui-starter Blog (Atom)" href={`${SITE}/feed.atom`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Martian+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="gpui-starter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime.toISOString()} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime.toISOString()} />
    )}
    {ogType === 'article' && articleTags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hmziqrs" />
    <meta name="twitter:creator" content="@hmziqrs" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:domain" content="gpui-starter.freeoxide.com" />
    <meta property="pinterest:media" content={ogImageUrl} />
    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <script is:inline>
      requestIdleCallback(() => {
        import('https://www.gstatic.com/firebasejs/12.13.0/firebase-app.js').then(({ initializeApp }) => {
          const firebaseConfig = { apiKey: 'AIzaSyDI-CutFk3prIj64gQfz332Cnrvh3xeUfc', authDomain: 'gpui-starter.firebaseapp.com', projectId: 'gpui-starter', storageBucket: 'gpui-starter.firebasestorage.app', messagingSenderId: '117315648896', appId: '1:117315648896:web:4291ed5b219b49d7cfd565', measurementId: 'G-9KJX86QRFG' };
          const app = initializeApp(firebaseConfig);
          import('https://www.gstatic.com/firebasejs/12.13.0/firebase-analytics.js').then(({ getAnalytics }) => { getAnalytics(app); });
        });
      });
    </script>
    <style is:global>
      @import '../styles/globals.css';
    </style>
  </head>
  <body>
    <!-- ===== ANNOUNCEMENT ===== -->
    <a
      href="/changelog/"
      class="block bg-black no-underline border-b border-line"
    >
      <div class="wrap h-10 flex items-center justify-center gap-2.5 text-[13px] text-fg text-center">
        <span class="truncate">gpui-starter v{latestVersion} · {latestHighlight()}</span>
        <span class="text-fg-muted shrink-0">&rarr;</span>
      </div>
    </a>

    <!-- ===== HEADER ===== -->
    <header
      class="sticky top-0 z-50 backdrop-blur-xl border-b border-line"
      style="background:rgb(13 10 12 / 86%)"
    >
      <div class="wrap h-16 flex items-center gap-6">
        <a href="/" class="flex items-center gap-2.5 no-underline text-fg shrink-0">
          <span
            class="grid place-items-center w-7 h-7 bg-fg text-canvas mono text-[13px] font-semibold rounded-[7px]"
            aria-hidden="true">g</span
          >
          <span class="display text-[20px] tracking-[-.03em]">gpui-starter</span>
        </a>

        <nav class="hidden md:flex items-center gap-1 ml-3" aria-label="Main navigation">
          <a href="/docs/getting-started/" class="nav-link" aria-current={navSeg === 'docs' ? 'page' : undefined}>Docs</a>
          <a href="/blog/" class="nav-link" aria-current={navSeg === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="/faq/" class="nav-link" aria-current={navSeg === 'faq' ? 'page' : undefined}>FAQ</a>
          <a href="/changelog/" class="nav-link" aria-current={navSeg === 'changelog' ? 'page' : undefined}>Changelog</a>
          <a href="/about/" class="nav-link" aria-current={navSeg === 'about' ? 'page' : undefined}>About</a>
        </nav>

        <div class="flex items-center gap-2 ml-auto">
          <a
            href="https://github.com/freeoxide/gpui-starter"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="hidden sm:grid place-items-center w-9 h-9 rounded-full text-fg-muted hover:text-fg hover:bg-raise no-underline transition-colors"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path
                d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.3 1.2A11.5 11.5 0 0 1 12 5.8c1 0 2 .1 3 .4 2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"
              ></path></svg
            >
          </a>
          <a href="/docs/getting-started/" class="btn btn-solid">Install</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="border-t border-line">
      <div class="wrap py-14 grid grid-cols-2 lg:grid-cols-5 gap-10">
        <div class="col-span-2 lg:col-span-1">
          <div class="flex items-center gap-2.5">
            <span
              class="grid place-items-center w-7 h-7 bg-fg text-canvas mono text-[13px] font-semibold rounded-[7px]"
              aria-hidden="true">g</span
            >
            <span class="display text-[18px] tracking-[-.03em]">gpui-starter</span>
          </div>
          <p class="text-[13.5px] text-fg-muted mt-4 max-w-[30ch] leading-relaxed">
            A GPUI desktop boilerplate. Routing, themes, i18n, SQLite, keyring, tray
            and signed updates are already wired up. MIT licensed.
          </p>
        </div>

        <div>
          <p class="eyebrow">Product</p>
          <ul class="list-none p-0 mt-4 space-y-2.5 text-[13.5px]">
            <li><a href="/docs/getting-started/" class="qlink">Get started</a></li>
            <li><a href="/docs/themes/" class="qlink">Themes</a></li>
            <li><a href="/docs/i18n/" class="qlink">i18n</a></li>
            <li><a href="/docs/forms/" class="qlink">Forms</a></li>
            <li><a href="/changelog/" class="qlink">Changelog</a></li>
          </ul>
        </div>

        <div>
          <p class="eyebrow">Resources</p>
          <ul class="list-none p-0 mt-4 space-y-2.5 text-[13.5px]">
            <li><a href="/docs/architecture/" class="qlink">Architecture</a></li>
            <li><a href="/docs/performance/" class="qlink">Performance</a></li>
            <li><a href="/faq/" class="qlink">FAQ</a></li>
            <li><a href="/blog/" class="qlink">Blog</a></li>
          </ul>
        </div>

        <div>
          <p class="eyebrow">Community</p>
          <ul class="list-none p-0 mt-4 space-y-2.5 text-[13.5px]">
            <li><a href="/about/" class="qlink">About</a></li>
            <li>
              <a href="https://github.com/freeoxide/gpui-starter" target="_blank" rel="noopener" class="qlink">GitHub</a>
            </li>
            <li>
              <a href="https://github.com/freeoxide/gpui-starter/issues" target="_blank" rel="noopener" class="qlink">Issues</a>
            </li>
            <li><a href="https://hmziq.rs" target="_blank" rel="noopener" class="qlink">hmziq.rs</a></li>
          </ul>
        </div>

        <div>
          <p class="eyebrow">Legal</p>
          <ul class="list-none p-0 mt-4 space-y-2.5 text-[13.5px]">
            <li><a href="/privacy/" class="qlink">Privacy policy</a></li>
            <li><a href="/terms/" class="qlink">Terms of use</a></li>
            <li>
              <a
                href="https://github.com/freeoxide/gpui-starter/blob/master/LICENSE"
                target="_blank"
                rel="noopener"
                class="qlink">MIT license</a
              >
            </li>
          </ul>
        </div>
      </div>

      <div class="wrap pb-10 flex flex-wrap justify-between gap-4 mono text-[11px] text-fg-subtle">
        <span>&copy; 2026 hmziqrs &middot; MIT</span>
        <div class="flex items-center gap-4">
          <a href="/sitemap-index.xml" class="qlink">Sitemap</a>
          <span>v{latestVersion}</span>
        </div>
      </div>
    </footer>

    <script>
      // ---------- Copy-to-clipboard ----------
      document.querySelectorAll<HTMLElement>('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy || '');
          } catch {
            /* clipboard unavailable, nothing to do */
          }
          const prev = btn.innerHTML;
          btn.textContent = '✓';
          setTimeout(() => {
            btn.innerHTML = prev;
          }, 1100);
        });
      });

      // ---------- Reveal on scroll ----------
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0, rootMargin: '0px 0px -10% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
